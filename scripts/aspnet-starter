#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: $0 init <project-name> <empty-directory> [--profile user-service|minimal]" >&2
  echo "       $0 check <generated-directory>" >&2
  exit 2
}

command=${1:-}
if [[ "$command" == "check" ]]; then
  metadata=${2:-}/.aspnet-starter.json
  [[ -f "$metadata" ]] || { echo "Starter metadata not found: $metadata" >&2; exit 1; }
  if ! grep -q '"templateVersion"' "$metadata"; then
    echo "Unsupported starter metadata: $metadata" >&2
    exit 1
  fi
  echo "Starter metadata:"
  sed -n 's/[{}]//g; s/[",]//g; s/^ */  /p' "$metadata"
  exit 0
fi
[[ "$command" == "init" ]] || usage
project_name=${2:-}
destination=${3:-}
profile=user-service
if [[ ${4:-} == "--profile" ]]; then
  profile=${5:-}
elif [[ -n ${4:-} ]]; then
  usage
fi
[[ -n "$project_name" && -n "$destination" ]] || usage
[[ "$profile" == "minimal" || "$profile" == "user-service" ]] || { echo "Profile must be 'user-service' or 'minimal'." >&2; exit 2; }

case "$project_name" in
  (*[!a-zA-Z0-9_-]*|'') echo "Project name must contain only letters, numbers, '_' or '-'." >&2; exit 2 ;;
esac

if [[ -e "$destination" ]] && [[ -n "$(find "$destination" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
  echo "Destination must be empty: $destination" >&2
  exit 1
fi
mkdir -p "$destination"
destination="$(cd "$destination" && pwd)"
source_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ "$profile" == "minimal" ]]; then
  cp -R "$source_root/templates/minimal/." "$destination/"
else
  # Copy the maintained full profile, including local changes, so generation
  # also works before the repository changes have been committed.
  cp -R "$source_root/." "$destination/"
  find "$destination" -type d \( -name .git -o -name bin -o -name obj \) -prune -exec rm -rf {} +
fi

identifier="$(printf '%s' "$project_name" | tr -d '_-')"
[[ "$identifier" =~ ^[a-zA-Z] ]] || identifier="Api$identifier"
find "$destination" -depth -name '*@PROJECT_NAME@*' -exec sh -c '
  project_name=$1
  shift
  for path do
    mv "$path" "$(dirname "$path")/${project_name}${path##*@PROJECT_NAME@}"
  done
' sh "$project_name" {} +
find "$destination" -type f \
  \( -name '*.cs' -o -name '*.csproj' -o -name '*.sln' -o -name '*.json' \
  -o -name '*.md' -o -name '*.yml' -o -name '*.yaml' -o -name '*.sh' -o -name 'Dockerfile*' \
  \) -exec sed -i.bak \
  -e "s/@PROJECT_NAME@/$project_name/g" \
  -e "s/AspNetCoreApiStarter/$identifier/g" \
  -e "s/aspnet-core-api-starter/$project_name/g" {} +
find "$destination" -name '*.bak' -delete

cat > "$destination/.aspnet-starter.json" <<EOF
{
  "templateVersion": "1.0.0",
  "profile": "$profile",
  "sourceCommit": "$(git -C "$source_root" rev-parse --short HEAD 2>/dev/null || echo unknown)"
}
EOF

echo "Generated $profile ASP.NET API: $destination"
echo "Template version: 1.0.0"
echo "Next steps:"
echo "  cd $destination"
echo "  dotnet restore"
echo "  dotnet build"
